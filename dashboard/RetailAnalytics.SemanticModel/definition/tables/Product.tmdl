/// Sản phẩm bán ra, một dòng mỗi sản phẩm, kèm nhóm hàng.
table Product
	lineageTag: 23036a49-9c63-43bd-b1f5-a6a7a032aa22

	/// Mã sản phẩm dùng để lọc và nối với bảng doanh thu.
	column 'Product ID'
		dataType: string
		isKey
		lineageTag: f95f07e3-bf66-4497-b667-91470f53117a
		summarizeBy: none
		sourceColumn: product_id

	/// Nhóm hàng của sản phẩm.
	column Category
		dataType: string
		lineageTag: 22df6dc3-18e5-44d6-a92a-7dbbbacd3281
		summarizeBy: none
		sourceColumn: category_id

	partition Product = m
		mode: import
		source =
				let
					// Đọc bảng sản phẩm từ PostgreSQL.
					Source = PostgreSQL.Database(#"Server", #"Database"),
					#"Navigated to products" = Source{[Schema = "public", Item = "products"]}[Data],
					#"Selected product columns" = Table.SelectColumns(#"Navigated to products", {"product_id", "category_id"})
				in
					#"Selected product columns"

	annotation PBI_ResultType = Table

