/// Thời điểm Power BI nạp dữ liệu từ PostgreSQL lần gần nhất (giờ Việt Nam, UTC+7). Chỉ phục vụ dòng "Cập nhật dữ liệu" trên báo cáo.
table 'Refresh Time'
	isHidden
	lineageTag: 97bbe79a-5220-4812-bef8-09d8011b089a

	/// Chuỗi hiển thị trên báo cáo: nhãn "Cập nhật:" kèm thời điểm nạp gần nhất.
	measure 'Last Refresh Text' = "Cập nhật: " & FORMAT(MAX('Refresh Time'[Refreshed At]), "dd/MM/yyyy HH:mm")
		formatString: General
		displayFolder: Info
		lineageTag: ce898d09-dedd-4fe8-a7ec-90ecd3558982

	/// Thời điểm nạp dữ liệu gần nhất (giờ Việt Nam).
	column 'Refreshed At'
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		lineageTag: a4b60678-a146-4168-8d0a-4e16af7e3af7
		summarizeBy: none
		sourceColumn: Refreshed At

	partition 'Refresh Time' = m
		mode: import
		source =
				let
				    // Ghi lại thời điểm nạp dữ liệu, quy đổi sang giờ Việt Nam (UTC+7).
				    #"Captured refresh time" = DateTime.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), 7)),
				    #"Created refresh table" = #table(type table [Refreshed At = datetime], {{#"Captured refresh time"}})
				in
				    #"Created refresh table"

