			RETURN
			    DIVIDE(_cur - _prev, _prev)
		formatString: 0.0%
		isHidden
		displayFolder: Compare
		lineageTag: 540f6fa8-5533-4dd8-ab76-25ac1352e491

	/// Dòng chữ so sánh với giờ trước (Quantity).
