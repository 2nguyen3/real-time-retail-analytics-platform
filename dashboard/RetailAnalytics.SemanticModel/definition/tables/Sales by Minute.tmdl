/// Doanh thu theo cửa hàng và từng phút (UTC) cho một lượt chạy. Bảng duy nhất có thời gian nên chỉ dùng cho trang Thời gian và biểu đồ xu hướng.
table 'Sales by Minute'
	lineageTag: a205541b-f681-4654-999c-8f99842f67a5

	/// Tổng doanh thu (USD mô phỏng) trong khoảng thời gian đang lọc.
	measure 'Minute Revenue' = SUM('Sales by Minute'[Total Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: cfd6789b-cc0a-4f56-8931-60a1dd968e00

	/// Doanh thu trung bình mỗi giờ trong ngày, tính trên tổng doanh thu của từng giờ (gộp các ngày đang lọc).
	measure 'Avg Revenue per Hour' = AVERAGEX(VALUES('Sales by Minute'[Hour]), [Minute Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: bb7b666a-0248-4e72-804a-102ccd318be4

	/// Doanh thu của giờ cao điểm: giờ trong ngày có tổng doanh thu lớn nhất (gộp các ngày đang lọc).
	measure 'Peak Hour Revenue' = MAXX(VALUES('Sales by Minute'[Hour]), [Minute Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: 25107555-e688-4514-a735-5c1d3197e8a4

	/// Giờ cao điểm: giờ trong ngày có tổng doanh thu lớn nhất (gộp các ngày đang lọc).
	measure 'Busiest Hour' =
			VAR _byHour = ADDCOLUMNS(VALUES('Sales by Minute'[Hour]), "@Revenue", [Minute Revenue])
			VAR _top = TOPN(1, _byHour, [@Revenue], DESC)
			RETURN
				MAXX(_top, 'Sales by Minute'[Hour])
		formatString: General
		displayFolder: Time
		lineageTag: dbfb8731-e944-40d5-880b-81a478c2ff19

	/// Số dòng giao dịch trong khoảng thời gian đang lọc.
	measure 'Minute Transactions' = SUM('Sales by Minute'[Transaction Count])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 3de4d2c3-e763-47ea-966e-b037eb2de233

	/// Tổng số lượng bán ra trong khoảng thời gian đang lọc.
	measure 'Minute Quantity' = SUM('Sales by Minute'[Total Quantity])
		formatString: #,##0
		displayFolder: Quantity
		lineageTag: af8f928e-9568-4731-99ed-3fcd0a968716

	/// Doanh thu trung bình mỗi dòng giao dịch trong khoảng thời gian đang lọc.
	measure 'Minute Avg Transaction' = DIVIDE([Minute Revenue], [Minute Transactions])
		formatString: #,##0.00
		displayFolder: Value
		lineageTag: be212a73-8c50-4e34-abb3-0858e99e2a54

	/// Giờ đầy đủ gần nhất: bỏ giờ cuối cùng vì có thể chưa đủ dữ liệu.
	measure 'Latest Hour Key' =
			VAR _all = ALLSELECTED('Sales by Minute'[Hour Key])
			VAR _max = MAXX(_all, 'Sales by Minute'[Hour Key])
			RETURN
			    MAXX(FILTER(_all, 'Sales by Minute'[Hour Key] < _max), 'Sales by Minute'[Hour Key])
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: ed5d0997-ca9b-449e-ac28-19574dab1e95

	/// Giờ liền trước giờ đầy đủ gần nhất.
	measure 'Previous Hour Key' =
			VAR _latest = [Latest Hour Key]
			RETURN
			    MAXX(FILTER(ALLSELECTED('Sales by Minute'[Hour Key]), 'Sales by Minute'[Hour Key] < _latest), 'Sales by Minute'[Hour Key])
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: e3d2d7ad-d618-4b3a-b56e-40ba5b1a21c7

	/// Thay đổi của giờ đầy đủ gần nhất so với giờ trước (Revenue).
	measure 'HoH Revenue' =
			VAR _latest = [Latest Hour Key]
			VAR _previous = [Previous Hour Key]
			VAR _cur = CALCULATE([Minute Revenue], REMOVEFILTERS('Sales by Minute'[Hour Key]), 'Sales by Minute'[Hour Key] = _latest)
			VAR _prev = CALCULATE([Minute Revenue], REMOVEFILTERS('Sales by Minute'[Hour Key]), 'Sales by Minute'[Hour Key] = _previous)
			RETURN
			    DIVIDE(_cur - _prev, _prev)
		formatString: 0.0%
		isHidden
		displayFolder: Compare
		lineageTag: 0a7e58df-3b55-4724-907f-33d7e3e48a1c

	/// Dòng chữ so sánh với giờ trước (Revenue).
	measure 'HoH Revenue Text' =
			VAR _x = [HoH Revenue]
			RETURN
			    IF(ISBLANK(_x), "Giờ trước  —", "Giờ trước  " & IF(_x >= 0, "▲ ", "▼ ") & FORMAT(ABS(_x), "0.0%"))
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: cb036f78-9c5f-405e-9d28-1de4ac4b802c

	/// Màu chữ so sánh với giờ trước (Revenue): xanh khi tăng, cam khi giảm.
	measure 'HoH Revenue Color' =
			VAR _x = [HoH Revenue]
			RETURN
			    IF(ISBLANK(_x), "#7C8FA3", IF(_x >= 0, "#2E9E6B", "#E0643C"))
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: bdbcb41c-e088-4763-aad4-714fab6465b0

	/// Giờ đầy đủ gần nhất so với trung bình các giờ (Revenue).
	measure 'VsAvg Revenue' =
			VAR _latest = [Latest Hour Key]
			VAR _cur = CALCULATE([Minute Revenue], REMOVEFILTERS('Sales by Minute'[Hour Key]), 'Sales by Minute'[Hour Key] = _latest)
			VAR _avg = AVERAGEX(FILTER(ALLSELECTED('Sales by Minute'[Hour Key]), 'Sales by Minute'[Hour Key] <= _latest), CALCULATE([Minute Revenue]))
			RETURN
			    DIVIDE(_cur - _avg, _avg)
		formatString: 0.0%
		isHidden
		displayFolder: Compare
		lineageTag: 955bd380-a5fb-40c2-a145-f0968143a8a6

	/// Dòng chữ so sánh với trung bình giờ (Revenue).
	measure 'VsAvg Revenue Text' =
			VAR _x = [VsAvg Revenue]
			RETURN
			    IF(ISBLANK(_x), "TB giờ  —", "TB giờ  " & IF(_x >= 0, "▲ ", "▼ ") & FORMAT(ABS(_x), "0.0%"))
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: 77e7151e-7e9f-4c77-939c-43bba76c9a43

	/// Màu chữ so sánh với trung bình giờ (Revenue).
	measure 'VsAvg Revenue Color' =
			VAR _x = [VsAvg Revenue]
			RETURN
			    IF(ISBLANK(_x), "#7C8FA3", IF(_x >= 0, "#2E9E6B", "#E0643C"))
		formatString: General
		isHidden
		displayFolder: Compare
		lineageTag: 63ac7088-0b49-46b3-b0b0-42354d3bf9c3

	/// Thay đổi của giờ đầy đủ gần nhất so với giờ trước (Quantity).
	measure 'HoH Quantity' =
			VAR _latest = [Latest Hour Key]
