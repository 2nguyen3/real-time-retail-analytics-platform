/// Doanh thu tổng hợp theo cửa hàng và sản phẩm cho một lượt chạy (Run ID). Mỗi dòng là một cặp cửa hàng và sản phẩm.
table Sales
	lineageTag: 6aafe16a-5bf0-4cbe-b60b-e908d7416ac8

	/// Tổng doanh thu (USD mô phỏng) của phần đang lọc.
	measure Revenue = SUM(Sales[Total Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: 500a36c0-525e-45fd-bf9a-9b40a1fcca60

	/// Tổng số lượng sản phẩm bán ra.
	measure Quantity = SUM(Sales[Total Quantity])
		formatString: #,##0
		displayFolder: Quantity
		lineageTag: 087ba911-745e-4d7d-984a-f531492973f2

	/// Số dòng giao dịch. Mỗi dòng giao dịch là một dòng sản phẩm của một hóa đơn.
	measure Transactions = SUM(Sales[Transaction Count])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 5aa609b9-86cb-4faa-b273-e57103b8c3ae

	/// Doanh thu trung bình trên mỗi dòng giao dịch.
	measure 'Avg Revenue per Transaction' = DIVIDE([Revenue], [Transactions])
		formatString: #,##0.00
		displayFolder: Value
		lineageTag: c41c612f-bd2c-4424-8ae2-eaec30c3917f

	/// Tỷ trọng doanh thu của phần đang lọc trên tổng trong phạm vi người xem được phép thấy (RLS vẫn áp dụng, bộ lọc Cửa hàng và Nhóm hàng bị bỏ khi tính mẫu số).
	measure 'Revenue Share' =
			DIVIDE(
				[Revenue],
				CALCULATE([Revenue], REMOVEFILTERS(Store), REMOVEFILTERS(Product))
			)
		formatString: 0.0%
		displayFolder: Value
		lineageTag: 50e302ab-7849-4ae4-8a28-946cfe466f77

	/// Chênh lệch doanh thu của một cửa hàng so với doanh thu trung bình các cửa hàng (cùng vùng và nhóm hàng đang lọc). Chỉ có giá trị khi chọn đúng một cửa hàng.
	measure 'Revenue vs Store Avg' =
			VAR _averageStoreRevenue = AVERAGEX(ALL(Store[Store ID]), [Revenue])
			RETURN
				IF(
					HASONEVALUE(Store[Store ID]),
					DIVIDE([Revenue] - _averageStoreRevenue, _averageStoreRevenue)
				)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Value
		lineageTag: f594558d-212c-4c18-83a5-3ac05a7f125b

	/// Thứ hạng doanh thu của cửa hàng trong các cửa hàng được phép thấy. Chỉ có giá trị khi chọn đúng một cửa hàng.
	measure 'Store Rank' =
			IF(
				HASONEVALUE(Store[Store ID]),
				RANKX(ALL(Store[Store ID]), [Revenue], , DESC, DENSE)
			)
		formatString: 0
		displayFolder: Value
		lineageTag: 07661683-44b4-4dd5-9326-9a3261567ed6

	/// Số sản phẩm khác nhau đã bán trong phần đang lọc.
	measure 'Distinct Products' = DISTINCTCOUNT(Sales[Product ID])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: cb544e47-fc29-4dc5-8d5d-5a5181fccbb6

	/// Mười sản phẩm doanh thu cao nhất chiếm bao nhiêu phần trăm doanh thu của phần đang lọc. Đo độ tập trung của doanh thu.
	measure 'Top 10 Product Share' =
			VAR _topProducts = TOPN(10, VALUES(Product[Product ID]), [Revenue], DESC)
			VAR _topRevenue = SUMX(_topProducts, [Revenue])
			RETURN
				DIVIDE(_topRevenue, [Revenue])
		formatString: 0.0%
		displayFolder: Value
		lineageTag: bc2cf644-c42e-4846-937a-a928dd713e7d

	/// Số cửa hàng có doanh thu trong phần đang lọc.
	measure 'Store Count' = DISTINCTCOUNT(Sales[Store ID])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 6ffe88f3-18c7-459e-92ff-61c68610d65e

	/// Doanh thu trung bình của mỗi cửa hàng trong phần đang lọc.
	measure 'Avg Revenue per Store' = AVERAGEX(VALUES(Store[Store ID]), [Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: a05f878e-38a1-480a-bed6-1868b6794a8c

	/// Doanh thu của cửa hàng cao nhất trong phần đang lọc.
	measure 'Top Store Revenue' = MAXX(VALUES(Store[Store ID]), [Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: ce5be73f-d5bb-4616-9576-c6272d3ad846

	/// Doanh thu của cửa hàng thấp nhất trong phần đang lọc.
	measure 'Bottom Store Revenue' = MINX(VALUES(Store[Store ID]), [Revenue])
		formatString: #,##0
		displayFolder: Value
		lineageTag: 80d13a41-cb64-4138-bef5-2582484b60ec

	/// Khóa cửa hàng, dùng để nối với bảng Store.
	column 'Store ID'
		dataType: string
		isHidden
		lineageTag: 23f36f88-190d-4374-8289-5b99c93d7b31
		summarizeBy: none
		sourceColumn: store_id

	/// Khóa sản phẩm, dùng để nối với bảng Product.
	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: 58425c45-52fa-4533-8a82-ecf069bc71fa
		summarizeBy: none
		sourceColumn: product_id

	column 'Transaction Count'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 04b9f6e9-491b-4df4-98fe-3a231bd395f6
		summarizeBy: none
		sourceColumn: transaction_count

	column 'Total Quantity'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 43534d6c-3cbc-40f6-bae3-b52e3dee30eb
		summarizeBy: none
		sourceColumn: total_quantity

	column 'Total Revenue'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 6833b5b0-738a-4134-93de-e9a57b9efd65
		summarizeBy: none
		sourceColumn: total_revenue

	partition Sales = m
		mode: import
		source =
				let
					// Đọc bảng tổng hợp theo cửa hàng và sản phẩm, chỉ giữ một run để không cộng trùng.
					Source = PostgreSQL.Database(#"Server", #"Database"),
					#"Navigated to store product sales" = Source{[Schema = "public", Item = "sales_by_store_product"]}[Data],
					#"Filtered to selected run" = Table.SelectRows(#"Navigated to store product sales", each [run_id] = #"Run ID"),
					#"Selected sales columns" = Table.SelectColumns(#"Filtered to selected run", {"store_id", "product_id", "transaction_count", "total_quantity", "total_revenue"}),
					#"Changed column types" = Table.TransformColumnTypes(#"Selected sales columns", {{"transaction_count", Int64.Type}, {"total_quantity", Int64.Type}, {"total_revenue", Currency.Type}})
				in
					#"Changed column types"

