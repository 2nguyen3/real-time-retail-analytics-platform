/// Cửa hàng của chuỗi, một dòng mỗi cửa hàng. Vùng là nhãn demo do nhóm gán, không phải dữ liệu nguồn.
table Store
	lineageTag: 03802128-2407-4a40-9760-44539bec12b0

	/// Mã cửa hàng dùng để lọc và nối với bảng doanh thu.
	column 'Store ID'
		dataType: string
		isKey
		lineageTag: 644a3fa2-32b6-4f30-8779-a9db7d88ee30
		summarizeBy: none
		sourceColumn: store_id

	/// Vùng của cửa hàng (North hoặc South). Nhãn demo phục vụ phân quyền theo vùng, không phải dữ liệu nguồn.
	column Region
		dataType: string
		lineageTag: 995f6584-2054-4a35-8690-6e7faeb564ce
		summarizeBy: none
		sourceColumn: store_region

	partition Store = m
		mode: import
		source =
				let
					// Đọc bảng cửa hàng từ PostgreSQL.
					Source = PostgreSQL.Database(#"Server", #"Database"),
					#"Navigated to stores" = Source{[Schema = "public", Item = "stores"]}[Data],
					#"Selected store columns" = Table.SelectColumns(#"Navigated to stores", {"store_id", "store_region"})
				in
					#"Selected store columns"

